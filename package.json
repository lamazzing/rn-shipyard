{
  "name": "rn-shipyard",
  "version": "0.1.0",
  "description": "Build and submit Expo apps locally on your Mac using Fastlane, a local alternative to EAS Build and Submit",
  "main": "dist/index.js",
  "bin": {
    "rn-shipyard": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamazzing/rn-shipyard.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "fastlane",
    "build",
    "submit",
    "eas",
    "ios",
    "android"
  ],
  "author": "Luca Mazzi <luca.mazzi.dev@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lamazzing/rn-shipyard/issues"
  },
  "homepage": "https://github.com/lamazzing/rn-shipyard#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "ora": "^9.4.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "os": [
    "darwin"
  ]
}
