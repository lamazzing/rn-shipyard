default_platform(:<%= ios ? "ios" : "android" %>)

<% if (ios) { %>
platform :ios do
  desc "Build iOS app"
  lane :build do |options|
    # match keeps the configured git_url (its keychain passphrase lookup is keyed by it). Before this
    # lane rn-shipyard clones that repo itself (so git/ssh can prompt on your terminal) and
    # redirects git to the local clone through GIT_CONFIG_* environment variables.
    match(
      type: <%- rb(ios.matchType) %>,
      readonly: true,
      app_identifier: <%- rb(ios.bundleId) %>,
      team_id: <%- rb(ios.teamId) %>
    )
    # rn-shipyard detects the workspace and scheme that expo prebuild generated (Expo
    # sanitises the iOS project name) and passes them in as workspace: / scheme:.
    UI.user_error!("Pass workspace: and scheme: (rn-shipyard build does this)") unless options[:workspace] && options[:scheme]
    gym(
      workspace: options[:workspace],
      scheme: options[:scheme],
      export_method: "app-store",
      output_directory: options[:output_dir] || "./output",
      output_name: options[:output_name] || <%- rb(appName + ".ipa") %>
    )
  end

  desc "Log in to App Store Connect (interactive step run by rn-shipyard submit before the upload)"
  lane :shipyard_apple_login do
    user = ENV["FASTLANE_USER"].to_s
    UI.user_error!("FASTLANE_USER is not set") if user.empty?
    # Same login pilot does (App Store Connect web session only). With no password in the
    # environment or keychain, CredentialsManager asks for it and stores it in the keychain
    # (deliver.<user>); spaceship asks for the 2FA code and caches the session cookie that the
    # non-interactive submit lane then reuses.
    Spaceship::ConnectAPI.login(user, use_portal: false, use_tunes: true, skip_select_team: true)
    UI.success("Logged in to App Store Connect as " + user)
  end

  desc "Import EAS certificate + provisioning profile(s) into the Match repo (run by rn-shipyard init --from-eas)"
  lane :shipyard_match_import do
    require "json"
    require "match"
    # rn-shipyard converts the EAS distribution certificate (.cer + the private key as a traditional RSA PEM, which is what match stores as its .p12) in a private temp
    # directory and lists them in a JSON file: [{ "cer": ..., "p12": ..., "profile": ... }]. Secrets
    # (MATCH_PASSWORD, git auth) arrive through the environment, never in arguments.
    entries_file = ENV["SHIPYARD_IMPORT_ENTRIES_FILE"].to_s
    UI.user_error!("SHIPYARD_IMPORT_ENTRIES_FILE is not set") if entries_file.empty?
    entries = JSON.parse(File.read(entries_file))
    UI.user_error!("Nothing to import") if entries.empty?
    api_key = nil
    if [ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"], ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]].none? { |v| v.to_s.empty? } &&
       [ENV["APP_STORE_CONNECT_API_KEY_KEY"], ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]].any? { |v| !v.to_s.empty? }
      api_key = app_store_connect_api_key
    end
    # Match::Importer#import_cert: matches the certificate against the developer portal (so the stored
    # files carry its certificate id), encrypts with MATCH_PASSWORD, commits and pushes to the repo.
    # One call per provisioning profile (app + extensions); the certificate files are the same.
    entries.each do |entry|
      options = {}
      options[:api_key] = api_key unless api_key.nil?
      params = FastlaneCore::Configuration.create(Match::Options.available_options, options)
      params.load_configuration_file("Matchfile") # git_url, type, app_identifier, team_id (as `fastlane match import` does)
      Match::Importer.new.import_cert(
        params,
        cert_path: entry["cer"],
        p12_path: entry["p12"],
        profile_path: entry["profile"]
      )
    end
    UI.success("Imported " + entries.length.to_s + " provisioning profile(s) into the Match repository")
  end

  desc "Submit iOS app to App Store Connect"
  lane :submit do |options|
    # An App Store Connect API key given through APP_STORE_CONNECT_API_KEY_* environment variables
    if [ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"], ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]].none? { |v| v.to_s.empty? } &&
       [ENV["APP_STORE_CONNECT_API_KEY_KEY"], ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]].any? { |v| !v.to_s.empty? }
      app_store_connect_api_key
    end
    pilot(
      ipa: options[:ipa_path],
      skip_waiting_for_build_processing: true
    )
  end
end
<% } %>

<% if (android) { %>
platform :android do
  desc "Build Android app"
  lane :build do |options|
    # Signing passwords are NOT passed here: -P flags show up in `ps`. rn-shipyard exports
    # ORG_GRADLE_PROJECT_android.injected.signing.{store,key}.password in the environment,
    # which Gradle reads as project properties.
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => <% if (keystoreFallback) { %>options[:keystore_path] || <%- rb(keystoreFallback) %><% } else { %>options[:keystore_path]<% } %>,
        "android.injected.signing.key.alias" => options[:key_alias] || <%- rb(android.keystoreAlias) %>
      }
    )
  end

  desc "Submit Android app to Google Play"
  lane :submit do |options|
    supply(
      aab: options[:aab_path],
      track: options[:track] || "internal",
      release_status: options[:release_status] || "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      skip_upload_apk: true,
      json_key: options[:service_account_key]<% if (serviceAccountFallback) { %> || <%- rb(serviceAccountFallback) %><% } %>

    )
  end
end
<% } %>
