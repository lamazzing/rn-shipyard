# rn-shipyard Environment Variables
# Copy to .env and fill in your values

# ── iOS (required for iOS builds and submissions) ──
# Encryption password for Fastlane Match certificate repo
MATCH_PASSWORD=
# Git URL for Match certificate storage (e.g., git@github.com:user/certs.git)
MATCH_GIT_URL=
# Apple Developer Team ID (10-character alphanumeric, find at developer.apple.com/account)
APPLE_TEAM_ID=
# Apple ID email for App Store Connect submissions
FASTLANE_USER=
# App-specific password for 2FA (generate at appleid.apple.com → Security → App-Specific Passwords)
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=

# ── Android (required for Android builds) ──
# Release keystore password (set during rn-shipyard init)
ANDROID_KEYSTORE_PASSWORD=
# Release key password (set during rn-shipyard init)
ANDROID_KEY_PASSWORD=

# ── Android Submit (optional — required only for Google Play uploads) ──
# Path to Google Play service account JSON file (create at console.cloud.google.com → IAM)
SUPPLY_JSON_KEY=
